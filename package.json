{
  "name": "obsidian-mypaper-plugin",
  "version": "1.1.0",
  "description": "论文管理与基于 Codex Skill 的全文阅读笔记",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test tests/*.test.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "package": "npm run build && python3 scripts/package_release.py"
  },
  "keywords": [],
  "license": "0-BSD",
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^16.11.6",
    "esbuild": "0.25.5",
    "eslint-plugin-obsidianmd": "0.1.9",
    "globals": "14.0.0",
    "jiti": "2.6.1",
    "tslib": "2.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.35.1"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "obsidian": "latest"
  }
}
